# Migration-owner URL, used by `npm run prisma:migrate`.
DATABASE_URL=postgresql://bugdb_migration:change-me@127.0.0.1:5432/bugfinder

# AgentFlow inputs. At runtime DATABASE_URL should use a login that inherits
# the migration-created `agentflow_bugdb_app` role.
BUGFINDER_REPO_PATH=/absolute/path/to/checked-out/repository
BUGFINDER_REPOSITORY_URL=https://github.com/owner/repository.git
BUGFINDER_INPUT_REF=main
BUGFINDER_DEADLINE_SECONDS=14400

# Codex is the default and uses the existing Codex subscription login.
BUGFINDER_CODEX_MODEL=gpt-5.6-luna

# Bugfinder v3 (examples/bugfinder/v3): no database, one AgentFlow run per target.
# run.py clones and pins <BUGFINDER_WORKSPACE_ROOT>/<target>; set BUGFINDER_REPO_PATH
# instead to use an existing worktree as-is at its HEAD.
BUGFINDER_WORKSPACE_ROOT=/absolute/path/to/workspaces
# BUGFINDER_REPO_PATH=/absolute/path/to/pinned/worktree
# Append-only JSONL corpus searched for known findings and extended after every run.
BUGFINDER_KNOWN_FINDINGS=/absolute/path/to/known-findings.jsonl
# Only the pi profile (pi-glm-5-3) needs an OpenRouter key.
OPENROUTER_API_KEY=

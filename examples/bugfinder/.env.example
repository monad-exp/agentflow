# Migration-owner URL, used by `npm run prisma:migrate`.
DATABASE_URL=postgresql://bugdb_migration:change-me@127.0.0.1:5432/bugfinder

# AgentFlow inputs. At runtime DATABASE_URL should use a login that inherits
# the migration-created `agentflow_bugdb_app` role.
BUGFINDER_REPO_PATH=/absolute/path/to/checked-out/repository
BUGFINDER_REPOSITORY_URL=https://github.com/owner/repository.git
BUGFINDER_INPUT_REF=main
BUGFINDER_DEADLINE_SECONDS=14400

# Codex is the default and uses the existing Codex subscription login.
BUGFINDER_CODEX_MODEL=gpt-5.6-luna

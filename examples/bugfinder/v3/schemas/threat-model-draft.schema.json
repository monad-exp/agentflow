{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreatModelDraft",
  "description": "One worker's threat-model contribution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "scope",
    "assumptions",
    "exclusions",
    "actors",
    "assets",
    "trustBoundaries",
    "threats"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "trustBoundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trustBoundary"
      }
    },
    "threats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/threat"
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "role",
        "capabilities",
        "controlledInputs",
        "excludedPowers",
        "sourceRefs"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "controlledInputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludedPowers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "protectedResource",
        "securityProperties",
        "compromiseConsequences",
        "sourceRefs"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "protectedResource": {
          "type": "string",
          "minLength": 1
        },
        "securityProperties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compromiseConsequences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trustBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "sides",
        "entryPoints",
        "enforcedChecks",
        "sourceRefs"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sides": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entryPoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "enforcedChecks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "violation",
        "securityProperty",
        "attackSurface",
        "preconditions",
        "expectedImpact",
        "existingControls",
        "confidence",
        "openQuestions",
        "actorKeys",
        "assetKeys",
        "boundaryKeys",
        "sourceRefs"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "violation": {
          "type": "string",
          "minLength": 1
        },
        "securityProperty": {
          "type": "string",
          "minLength": 1
        },
        "attackSurface": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedImpact": {
          "type": "string",
          "minLength": 1
        },
        "existingControls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actorKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assetKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundaryKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

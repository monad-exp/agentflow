{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriageEvidence",
  "description": "Gate 2: one validity (or impact) experiment attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "state",
    "summary",
    "guidanceReview",
    "evidenceIds",
    "methods",
    "productionAssessment",
    "differentialResults"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "enum": [
        "VALIDITY",
        "IMPACT"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "PROVEN",
        "FALSIFIED",
        "INCONCLUSIVE"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "guidanceReview": {
      "$ref": "#/$defs/guidanceReview"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceMethod"
      }
    },
    "productionAssessment": {
      "oneOf": [
        {
          "$ref": "#/$defs/productionAssessment"
        },
        {
          "type": "null"
        }
      ]
    },
    "differentialResults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/differentialResult"
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url",
        "revision",
        "excerpt"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "documentation",
            "bounty-terms",
            "specification",
            "issue",
            "pull-request",
            "known-finding"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "guidanceReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedBehavior",
        "documentationStatus",
        "bountyStatus",
        "references"
      ],
      "properties": {
        "expectedBehavior": {
          "type": "string",
          "minLength": 1
        },
        "documentationStatus": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "CONTRADICTED",
            "UNKNOWN"
          ]
        },
        "bountyStatus": {
          "type": "string",
          "enum": [
            "IN_SCOPE",
            "OUT_OF_SCOPE",
            "UNKNOWN"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "evidenceMethod": {
      "type": "string",
      "enum": [
        "UNIT",
        "INTEGRATION",
        "SOLONET",
        "DIFFERENTIAL",
        "SANITIZER",
        "STATIC_PROOF",
        "STATISTICAL",
        "EXISTING"
      ]
    },
    "productionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "executionCommit",
        "consensusCommit",
        "protocolRevision",
        "attackerCapabilities",
        "entryPath",
        "defenseChecks",
        "honestNodesUnmodified",
        "mutationManifestRef",
        "environmentEquivalent",
        "evidenceIds"
      ],
      "properties": {
        "network": {
          "type": "string",
          "minLength": 1
        },
        "executionCommit": {
          "type": "string",
          "minLength": 1
        },
        "consensusCommit": {
          "type": "string",
          "minLength": 1
        },
        "protocolRevision": {
          "type": "string",
          "minLength": 1
        },
        "attackerCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "entryPath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "defenseChecks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "honestNodesUnmodified": {
          "type": "boolean"
        },
        "mutationManifestRef": {
          "type": "string",
          "minLength": 1
        },
        "environmentEquivalent": {
          "type": "boolean"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "differentialResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "fixtureHash",
        "prestateHash",
        "fork",
        "version",
        "command",
        "artifactRef",
        "normalizedOutcome"
      ],
      "properties": {
        "client": {
          "type": "string",
          "enum": [
            "monad",
            "geth",
            "nethermind"
          ]
        },
        "fixtureHash": {
          "type": "string",
          "minLength": 1
        },
        "prestateHash": {
          "type": "string",
          "minLength": 1
        },
        "fork": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "artifactRef": {
          "type": "string",
          "minLength": 1
        },
        "normalizedOutcome": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

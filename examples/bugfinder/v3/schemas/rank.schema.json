{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RankFiles",
  "description": "Security-relevance ranking of in-scope source files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rankedFiles"
  ],
  "properties": {
    "rankedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "score",
          "securityObjective",
          "rationale"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "securityObjective": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deduplicate",
  "description": "Partition of leads into candidate findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "callerKey",
          "title",
          "rootCause",
          "impact",
          "leadIds"
        ],
        "properties": {
          "callerKey": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rootCause": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "leadIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    }
  }
}

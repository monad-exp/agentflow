{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report",
  "description": "Markdown report for one confirmed finding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findingId",
    "markdown"
  ],
  "properties": {
    "findingId": {
      "type": "string",
      "minLength": 1
    },
    "markdown": {
      "type": "string",
      "minLength": 1
    }
  }
}

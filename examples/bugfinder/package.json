{
  "name": "agentflow-bugfinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@hono/node-server": "1.19.15"
  },
  "scripts": {
